<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:layout_marginTop="8dp"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceHeadlineMedium" />

        <!-- Status -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statusTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/status_empty_title"
                    android:textAppearance="?attr/textAppearanceTitleLarge" />

                <TextView
                    android:id="@+id/statusSubtitle"
                    style="@style/Hint"
                    android:text="@string/status_empty_hint"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <LinearLayout
                    android:id="@+id/statusCells"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <include android:id="@+id/cellLeft" layout="@layout/view_battery_cell" />
                    <include android:id="@+id/cellRight" layout="@layout/view_battery_cell" />
                    <include android:id="@+id/cellCase" layout="@layout/view_battery_cell" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/listeningMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/modeOff"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingHorizontal="4dp"
                        android:text="@string/mode_off" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/modeNoise"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingHorizontal="4dp"
                        android:text="@string/mode_noise" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/modeTransparency"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingHorizontal="4dp"
                        android:text="@string/mode_transparency" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/modeAdaptive"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:paddingHorizontal="4dp"
                        android:text="@string/mode_adaptive" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    android:id="@+id/statusProblem"
                    style="@style/Hint"
                    android:layout_marginTop="12dp"
                    android:textColor="?attr/colorError"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Setup -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/setupCard"
            style="@style/Card"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/setupList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/CardTitle" android:text="@string/setup_title" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Popup and wearing -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/CardTitle" android:text="@string/popup_title" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/popupConnect"
                    style="@style/Switch"
                    android:text="@string/popup_on_connect" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/popupLid"
                    style="@style/Switch"
                    android:text="@string/popup_on_lid" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/island"
                    style="@style/Switch"
                    android:text="@string/island"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/islandHint"
                    style="@style/Hint"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/islandSettings"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/island_settings"
                    android:visibility="gone" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/earPause"
                    style="@style/Switch"
                    android:text="@string/ear_pause" />

                <TextView style="@style/Hint" android:text="@string/ear_pause_hint" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/popupTest"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/popup_test" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Equalizer -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/CardTitle" android:text="@string/eq_title" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/eqEnabled"
                    style="@style/Switch"
                    android:text="@string/eq_enable" />

                <TextView
                    android:id="@+id/eqDetail"
                    style="@style/Hint"
                    android:visibility="gone" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/eqPresets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:selectionRequired="false"
                    app:singleSelection="true" />

                <LinearLayout
                    android:id="@+id/eqBands"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/eqReset"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/eq_reset" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/eqOnlyHeadphones"
                    style="@style/Switch"
                    android:text="@string/eq_only_headphones" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/eqPerSession"
                    style="@style/Switch"
                    android:text="@string/eq_per_session" />

                <TextView style="@style/Hint" android:text="@string/eq_per_session_hint" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Alarm -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/CardTitle" android:text="@string/alarm_title" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/alarmMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/alarmOff"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/alarm_off" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/alarmMirror"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:text="@string/alarm_mirror" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/alarmOnly"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.6"
                        android:text="@string/alarm_only" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    android:id="@+id/alarmExplain"
                    style="@style/Hint"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/alarmNext"
                    style="@style/Hint"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:labelFor="@+id/alarmVolume"
                    android:text="@string/alarm_volume"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/alarmVolume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="5"
                    android:valueFrom="10"
                    android:valueTo="100" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/alarmPickTone"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/alarm_pick_tone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/alarmTest"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/alarm_test" />
                </LinearLayout>

                <TextView
                    android:id="@+id/alarmTone"
                    style="@style/Hint"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Advanced -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/CardTitle" android:text="@string/advanced_title" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/scanCompat"
                    style="@style/Switch"
                    android:text="@string/scan_compat" />

                <TextView style="@style/Hint" android:text="@string/scan_compat_hint" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/diagnostics_title"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <TextView
                    android:id="@+id/diagnostics"
                    style="@style/Hint"
                    android:layout_marginTop="4dp"
                    android:textIsSelectable="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/diagnosticsCopy"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/diagnostics_copy" />

                <TextView
                    style="@style/Hint"
                    android:layout_marginTop="16dp"
                    android:text="@string/about" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
